# Shared
KNOT_ENV=local
GCP_PROJECT_ID=knot-dev-503505
GOOGLE_CLOUD_PROJECT=knot-dev-503505
GCP_REGION=us-central1
GIT_SHA=local
LOG_LEVEL=INFO

# Firestore / Vertex AI
KNOT_REPOSITORY_BACKEND=memory
FIRESTORE_DATABASE=(default)
KNOT_AUTH_MODE=firebase
FIREBASE_PROJECT_ID=knot-dev-503505
KNOT_GEMINI_MODE=off
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Creator onboarding public YouTube metrics. Prefer Secret Manager in Cloud Run.
YOUTUBE_API_KEY=
APIFY_TOKEN=
INSTAGRAM_PROVIDER=apify
INSTAGRAM_APIFY_ACTOR_ID=apify~instagram-profile-scraper
INSTAGRAM_APIFY_TIMEOUT_SECONDS=75

# Service URLs
KNOT_API_BASE_URL=http://localhost:8080
KNOT_CREATOR_A2A_MODE=local
KNOT_WEB3_MODE=local
CREATOR_AGENT_BASE_URL=http://localhost:8081/a2a/v1
BRAND_AGENT_BASE_URL=http://localhost:8083/brand/v1
CREATOR_A2A_TIMEOUT_SECONDS=30
WEB3_GATEWAY_BASE_URL=http://localhost:8082
KNOT_WEB3_SIGNING_MODE=simulated

# Firebase client (not admin secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=knot-dev-503505.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=knot-dev-503505
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Solana devnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
KNOT_ESCROW_PROGRAM_ID=Aj63B5hLtvJdNQiAi61rMrgfW3pt8Lak3GQB59B6jysj
KNOT_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
BRAND_SIGNER_SECRET_NAME=knot-devnet-brand-signer
# Local/devnet smoke only. Prefer Secret Manager mount on Cloud Run; never commit this file.
KNOT_BRAND_KEYPAIR_PATH=
KNOT_BRAND_KEYPAIR_JSON=
KNOT_CREATOR_KEYPAIR_PATH=
KNOT_CREATOR_KEYPAIR_JSON=
KNOT_AGENT_KEYPAIR_PATH=
KNOT_AGENT_KEYPAIR_JSON=
# 정산 서명자(플랫폼 소유). 설정하면 evidence 통과 시 서버가 자동 서명해 릴리즈한다.
KNOT_SETTLEMENT_AUTHORITY=
KNOT_SETTLEMENT_KEYPAIR_PATH=
KNOT_SETTLEMENT_KEYPAIR_JSON=
# 가스 대납 릴레이어. 설정하면 유저가 서명하는 tx 의 feePayer 가 이 지갑이 된다 → 유저 SOL 0.
KNOT_RELAYER_KEYPAIR_PATH=
KNOT_RELAYER_KEYPAIR_JSON=

# 자율 정산 / 임베디드 지갑
# evidence 통과 즉시 서버 서명으로 정산 (기본 on, 끄려면 0)
KNOT_AUTO_SETTLEMENT_ON_EVIDENCE=1
# 역할 선택 시 유저 커스터디 지갑 자동 생성 (기본 off)
KNOT_USER_WALLET_PROVISION=0

# pay.sh
PAYSH_MODE=sandbox
PAYSH_RESOURCE_ID=replace-me
PAYSH_TIMEOUT_SECONDS=90
PAYSH_SECRET_NAME=knot-paysh-token

# Safety
MAX_NEGOTIATION_ROUNDS=5
CONTENT_REVISION_LIMIT=1
