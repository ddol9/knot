# knot 백엔드 환경변수 예시 — 복사해서 .env 로 쓰고 실제 값 채우기 (.env는 커밋 금지)

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
KNOT_WEB3_SIGNING_MODE=simulated
# 배포 지갑 keypair 경로 (mainnet 키 절대 커밋 금지)
ANCHOR_WALLET=~/.config/solana/id.json
KNOT_BRAND_KEYPAIR_PATH=
KNOT_BRAND_KEYPAIR_JSON=
KNOT_CREATOR_KEYPAIR_PATH=
KNOT_CREATOR_KEYPAIR_JSON=
KNOT_AGENT_KEYPAIR_PATH=
KNOT_AGENT_KEYPAIR_JSON=

# USDC-SPL devnet mint (x402/pay.sh 표준 결제 토큰)
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# knot-escrow 프로그램 ID (anchor keys list 로 확인)
KNOT_ESCROW_PROGRAM_ID=Aj63B5hLtvJdNQiAi61rMrgfW3pt8Lak3GQB59B6jysj
KNOT_SETTLEMENT_AUTHORITY=

# devnet 통합 테스트 실행 스위치 (1이면 실행, 아니면 skip)
KNOT_RUN_DEVNET=0

# pay.sh / x402 sandbox verification
PAYSH_MODE=sandbox
PAYSH_RESOURCE_ID=replace-me
PAYSH_TIMEOUT_SECONDS=90
PAYSH_QUOTE_AMOUNT_USDC=0.02
PAYSH_MAX_CALL_AMOUNT_USDC=0.02
PAYSH_RUN_SPEND_CAP_USDC=0.02
PAYSH_DAILY_SPEND_CAP_USDC=1.0
PAYSH_ALLOWED_RESOURCE_PREFIXES=https://debugger.pay.sh/mpp/quote/
PAYSH_FAILURE_POLICY=continue

# Product API -> Creator A2A HTTP boundary
KNOT_CREATOR_A2A_MODE=local
CREATOR_AGENT_BASE_URL=http://localhost:8081/a2a/v1
BRAND_AGENT_BASE_URL=http://localhost:8083/brand/v1
CREATOR_A2A_TIMEOUT_SECONDS=30

# 자율 정산 / 임베디드 지갑
# evidence 통과 즉시 서버 서명으로 마일스톤 정산. 실패 시 수동 Phantom 릴리즈가 fallback.
KNOT_AUTO_SETTLEMENT_ON_EVIDENCE=1
# 역할 선택 시 유저 커스터디 지갑 자동 생성 (Secret Manager 쓰기 권한 필요)
KNOT_USER_WALLET_PROVISION=0
KNOT_SETTLEMENT_AUTHORITY=

# Firebase Auth
KNOT_AUTH_MODE=firebase
FIREBASE_PROJECT_ID=knot-dev-503505
# Local tests only: use KNOT_AUTH_MODE=emulator with Firebase Auth emulator tokens.

# Creator onboarding public YouTube metrics. Keep the real key out of git.
YOUTUBE_API_KEY=

# Creator onboarding public Instagram profile analysis via Apify.
# Keep the real token out of git. Default actor is Apify's profile scraper.
APIFY_TOKEN=
INSTAGRAM_PROVIDER=apify
INSTAGRAM_APIFY_ACTOR_ID=apify~instagram-profile-scraper
INSTAGRAM_APIFY_TIMEOUT_SECONDS=75

# 거버넌스 가드레일 (libs/policies/governance.py)
# 단건 합의가 이 금액을 넘으면 에스크로 전에 사람 승인(approvals/) 대기
KNOT_GOV_MAX_AUTO_AGREEMENT_USDC=800
# 캠페인 누적 확정이 이 금액을 넘으면 사람 승인 대기
KNOT_GOV_MAX_AUTO_CAMPAIGN_TOTAL_USDC=2000
# 최근 N건 연속 실패한 에이전트는 탐색에서 플래그(강등, 제외 아님)
KNOT_GOV_MAX_CONSECUTIVE_FAILURES=3
